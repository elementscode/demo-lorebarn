import "./style.css";
import { redirect } from "@elements/app";
import { signin } from "#app/shared/services/auth";
import { Logo } from "#app/shared/templates/logo";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardAction, CardContent } from "@elements/ui/card";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";

interface SigninForm {
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

interface DemoLogin {
  id: string;
  name: string;
  email: string;
  role: string;
}

const DEMO_PASSWORD = "lorebarn";

const DEMO_LOGINS: DemoLogin[] = [
  { id: "maya", name: "Maya Okafor", email: "maya@lorebarn.dev", role: "admin" },
  { id: "theo", name: "Theo Lindqvist", email: "theo@lorebarn.dev", role: "member" },
  { id: "priya", name: "Priya Raman", email: "priya@lorebarn.dev", role: "member" },
  { id: "jonah", name: "Jonah Reyes", email: "jonah@lorebarn.dev", role: "member" },
];

function onSubmit(form: SigninForm) {
  form.busy = true;

  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function onDemoClick(form: SigninForm, login: DemoLogin) {
  form.email = login.email;
  form.password = DEMO_PASSWORD;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  private form: SigninForm = { email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · lorebarn</title>
    <meta name="description" content="Sign in to the lorebarn team wiki.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="center">
      <div class="signin-wrap stack is-lg">
        <div class="signin-brand row">
          <Logo size={32} />
          lorebarn
        </div>

        <Card>
          <CardContent>
            <form class="stack" onsubmit={() => onSubmit(form)}>
              <div class="stack is-xs">
                <h1 class="text-2xl">Sign in</h1>
                <p class="text-sm text-ink-soft">Your team's wiki: specs, runbooks and the handbook.</p>
              </div>

              <Alert e:if={form.error} variant="danger" description={form.error} />

              <Field label="Email" required reserveError={false}>
                <Input type="email"
                       name="email"
                       value={form.email}
                       placeholder="you@company.com"
                       attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
              </Field>

              <Field label="Password" required reserveError={false}>
                <Input type="password"
                       name="password"
                       value={form.password}
                       attrs={{ id: "password", autocomplete: "current-password" }} />
              </Field>

              <Button type="submit" variant="primary" block loading={form.busy}>Sign in</Button>
            </form>
          </CardContent>
        </Card>

        <Card title="Demo accounts" level={2} size="sm" class="signin-demo">
          <CardAction slot="action">
            <span class="text-sm text-ink-soft">password <code>{DEMO_PASSWORD}</code></span>
          </CardAction>
          <CardContent>
            <ul class="stack is-sm">
              <li e:for={login of DEMO_LOGINS}>
                <Button variant="ghost" block onclick={() => onDemoClick(form, login)}>
                  <span class="who">
                    <span>{login.name}</span>
                    <small>{login.email}</small>
                  </span>
                  <Badge variant={login.role === "admin" ? "accent" : "secondary"}>{login.role}</Badge>
                </Button>
              </li>
            </ul>
          </CardContent>
        </Card>
      </div>
    </main>
  </body>
</html>
