import "./style.css";
import { redirect } from "@elements/app";
import { signin } from "#app/shared/services/auth";
import { Logo } from "#app/shared/templates/logo";
import favicon from "#app/shared/assets/favicons/favicon.svg";

interface SigninForm {
  email: string;
  password: string;
  error: string;
  busy: boolean;
}

interface DemoLogin {
  id: string;
  name: string;
  email: string;
  role: string;
}

const DEMO_PASSWORD = "lorebarn";

const DEMO_LOGINS: DemoLogin[] = [
  { id: "maya", name: "Maya Okafor", email: "maya@lorebarn.dev", role: "admin" },
  { id: "theo", name: "Theo Lindqvist", email: "theo@lorebarn.dev", role: "member" },
  { id: "priya", name: "Priya Raman", email: "priya@lorebarn.dev", role: "member" },
  { id: "jonah", name: "Jonah Reyes", email: "jonah@lorebarn.dev", role: "member" },
];

function onSubmit(form: SigninForm) {
  form.busy = true;

  try {
    signin(form.email, form.password);
    form.error = "";
    redirect("/");
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function onDemoClick(form: SigninForm, login: DemoLogin) {
  form.email = login.email;
  form.password = DEMO_PASSWORD;
  onSubmit(form);
}

<html lang="en" class="page-signin" (
  private form: SigninForm = { email: "", password: "", error: "", busy: false },
)>
  <head>
    <title>Sign in · lorebarn</title>
    <meta name="description" content="Sign in to the lorebarn team wiki.">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <main class="center">
      <div class="signin-wrap stack is-lg">
        <div class="signin-brand row">
          <Logo size={32} />
          lorebarn
        </div>

        <div class="card">
          <div class="card-body">
            <form class="stack" onsubmit={() => onSubmit(form)}>
              <div class="stack is-xs">
                <h1 class="text-2xl">Sign in</h1>
                <p class="text-sm text-ink-soft">Your team's wiki: specs, runbooks and the handbook.</p>
              </div>

              <div e:if={form.error} class="callout is-danger" role="alert">
                <div class="callout-body">{form.error}</div>
              </div>

              <div class="field">
                <label for="email">Email</label>
                <input id="email"
                       name="email"
                       type="email"
                       value={form.email}
                       autocomplete="email"
                       autocapitalize="none"
                       spellcheck={false}
                       placeholder="you@company.com"
                       required>
              </div>

              <div class="field">
                <label for="password">Password</label>
                <input id="password"
                       name="password"
                       type="password"
                       value={form.password}
                       autocomplete="current-password"
                       required>
              </div>

              <button type="submit" class={["is-primary is-block", form.busy && "is-loading"]} disabled={form.busy}>
                Sign in
              </button>
            </form>
          </div>
        </div>

        <div class="card signin-demo">
          <div class="card-head">
            <h2 class="text-base">Demo accounts</h2>
            <span class="text-sm text-ink-soft">password <code>{DEMO_PASSWORD}</code></span>
          </div>
          <div class="card-body">
            <ul class="stack is-sm">
              <li e:for={login of DEMO_LOGINS}>
                <button type="button" class="is-ghost" onclick={() => onDemoClick(form, login)}>
                  <span class="who">
                    <span>{login.name}</span>
                    <small>{login.email}</small>
                  </span>
                  <span class={["pill", login.role === "admin" && "is-accent"]}>{login.role}</span>
                </button>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
