import "./style.css";
import { LiveView, redirect, session } from "@elements/app";
import {
  SidebarProvider, Sidebar, SidebarHeader, SidebarContent, SidebarFooter, SidebarGroup,
  SidebarGroupLabel, SidebarGroupContent, SidebarMenu, SidebarMenuItem, SidebarMenuButton,
  SidebarMenuAction, SidebarMenuSub, SidebarMenuSubItem, SidebarMenuSubButton, SidebarInset,
  SidebarTrigger, SidebarInput,
} from "@elements/ui/sidebar";
import { Button } from "@elements/ui/button";
import { Icon } from "@elements/ui/icon";
import { Logo } from "#app/shared/templates/logo";
import { Avatar } from "#app/shared/templates/avatar";
import { signout } from "#app/shared/services/auth";
import { Page, Space, buildTree, flattenTree, pageUrl } from "#app/shared/services/pages";

interface SearchBox {
  q: string;
}

function onSearchSubmit(box: SearchBox) {
  let q = box.q.trim();
  redirect(q ? `/search?q=${encodeURIComponent(q)}` : "/search");
}

function onNewPageClick(tree: LiveView<Page>, space: Space) {
  let page = tree.insert({
    spaceSlug: space.slug,
    parentId: null,
    position: Number.MAX_SAFE_INTEGER,
    title: "Untitled",
    body: "",
    version: 1,
    createdAt: new Date(),
    updatedAt: new Date(),
    updatedByName: session.get("userName") ?? null,
  });

  redirect(`${pageUrl(page)}?edit=1`);
}

<Layout (
  spaces: Space[],
  activeSlug: string = "",
  tree: LiveView<Page> | null = null,
  activePageId: string = "",
  section: string = "",
  private box: SearchBox = { q: "" },
)>
  <SidebarProvider class="layout" shortcut="" cookie="">
    <Sidebar label="Main">
      <SidebarHeader>
        <a class="layout-brand row" href="/">
          <Logo size={26} />
          lorebarn
        </a>

        <form role="search" onsubmit={() => onSearchSubmit(box)}>
          <SidebarInput value={box.q} placeholder="Search pages" attrs={{ "aria-label": "Search pages" }} />
        </form>
      </SidebarHeader>

      <SidebarContent>
        <SidebarGroup>
          <SidebarGroupContent>
            <SidebarMenu>
              <SidebarMenuItem>
                <SidebarMenuButton href="/" isActive={section === "home"}><Icon name="home" /><span>Home</span></SidebarMenuButton>
              </SidebarMenuItem>
              <SidebarMenuItem>
                <SidebarMenuButton href="/search" isActive={section === "search"}><Icon name="search" /><span>Search</span></SidebarMenuButton>
              </SidebarMenuItem>
              <SidebarMenuItem e:if={session.get("role") === "admin"}>
                <SidebarMenuButton href="/admin/members" isActive={section === "members"}><Icon name="user" /><span>Members</span></SidebarMenuButton>
              </SidebarMenuItem>
            </SidebarMenu>
          </SidebarGroupContent>
        </SidebarGroup>

        <SidebarGroup>
          <SidebarGroupLabel>Spaces</SidebarGroupLabel>
          <SidebarGroupContent>
            <SidebarMenu>
              <SidebarMenuItem e:for={space of spaces}>
                <SidebarMenuButton href={`/s/${space.slug}`} isActive={space.slug === activeSlug && !activePageId}>
                  <span>{space.name}</span>
                </SidebarMenuButton>

                <SidebarMenuAction e:if={tree && space.slug === activeSlug}
                                   label={`New page in ${space.name}`}
                                   onclick={() => onNewPageClick(tree!, space)}>
                  <Icon name="plus" />
                </SidebarMenuAction>

                <SidebarMenuSub e:if={tree && space.slug === activeSlug} class="layout-tree">
                  <SidebarMenuSubItem e:for={node of flattenTree(buildTree(tree!))}>
                    <SidebarMenuSubButton href={pageUrl(node.page)}
                                          isActive={node.id === activePageId}
                                          attrs={{ title: node.page.title, style: `--depth: ${node.depth}` }}>
                      <span class="truncate">{node.page.title}</span>
                    </SidebarMenuSubButton>
                  </SidebarMenuSubItem>
                </SidebarMenuSub>
              </SidebarMenuItem>
            </SidebarMenu>
          </SidebarGroupContent>
        </SidebarGroup>
      </SidebarContent>

      <SidebarFooter>
        <div class="layout-user row">
          <Avatar id={session.get("userId") ?? ""} name={session.get("userName") ?? ""} />
          <span class="who">
            <span class="truncate">{session.get("userName")}</span>
            <small>{session.get("role")}</small>
          </span>
          <Button variant="ghost" size="sm" onclick={() => signout()}>Sign out</Button>
        </div>
      </SidebarFooter>
    </Sidebar>

    <SidebarInset class="layout-main">
      <div class="layout-phonebar row">
        <a class="layout-brand row" href="/">
          <Logo size={26} />
          lorebarn
        </a>
        <SidebarTrigger label="Menu" />
      </div>

      <slot/>
    </SidebarInset>
  </SidebarProvider>
</Layout>
