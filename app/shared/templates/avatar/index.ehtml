import "./style.css";
import { Avatar as UiAvatar } from "@elements/ui/avatar";
import { avatarHue, initials } from "#app/shared/services/format";

<Avatar (id: string, name: string, small: boolean = false, title: string = "")>
  <UiAvatar alt={name}
            fallback={initials(name)}
            size={small ? "sm" : "md"}
            class="is-hued"
            attrs={{ style: `--hue: ${avatarHue(id)}`, title: title || name }}>
    <slot/>
  </UiAvatar>
</Avatar>
